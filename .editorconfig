# ============================================================
# EditorConfig: 统一编辑器格式
# ============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,hpp,cc,cxx}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.cmake]
indent_style = space
indent_size = 4

[*.{py,json,yml,yaml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.{txt,log}]
trim_trailing_whitespace = false
insert_final_newline = false

[*.bat]
end_of_line = crlf
indent_style = tab

[*.ps1]
end_of_line = lf
indent_style = space
indent_size = 4

[profile_*]
end_of_line = lf
indent_style = space
indent_size = 4

[conanfile.txt]
end_of_line = lf
indent_style = space
indent_size = 4

[.gitignore]
end_of_line = lf
indent_style = space
indent_size = 4

[.editorconfig]
end_of_line = lf
indent_style = space
indent_size = 4
