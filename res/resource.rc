#include <winver.h>
#include "resource.h"

VS_VERSION_INFO	VERSIONINFO
FILEVERSION     1, 0, 0, 0
PRODUCTVERSION  1, 0, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "KBMacro"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "ProductName",     "KBMacro"
            VALUE "ProductVersion",  "1.0.0.0"
            VALUE "OriginalFilename","KBMacro.exe"
            VALUE "LegalCopyright",  "Copyright (C) 2026"
            VALUE "Comments",        "Licensed under GPL-3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#include "langs/zh-CN.rc"
#include "langs/en-US.rc"

IDI_APP_ICON                    ICON   "resources/KBMacro.ico"
IDR_LICENSE_KBMACRO             RCDATA "licenses/KBMacro.txt"
IDR_LICENSE_WXWIDGETS           RCDATA "licenses/wxWidgets.txt"
IDR_LICENSE_SPDLOG              RCDATA "licenses/spdlog.txt"
IDR_LICENSE_NLOHMANN_JSON       RCDATA "licenses/nlohmann-json.txt"
IDR_LICENSE_WIL                 RCDATA "licenses/WIL.txt"
IDR_LICENSE_CONCURRENTQUEUE     RCDATA "licenses/ConcurrentQueue.txt"
IDR_LICENSE_GTEST               RCDATA "licenses/GoogleTest.txt"
